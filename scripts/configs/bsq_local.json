{
  "data": {
    "data_dir": "/home/junda/Data/cn_1m_ohlcv_per_code",
    "tokenizer": "NeoQuasar/Kronos-Tokenizer-base",
    "min_bars": 30,
    "val_cutoff": "2026-01-01"
  },
  "train": {
    "batch_size": 64,
    "lr": 3e-4,
    "weight_decay": 0.01,
    "epochs": 5,
    "grad_clip": 1.0,
